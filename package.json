{
  "name": "anvil-extensions",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "workspaces": [
    "packages/*"
  ],
  "pi": {
    "extensions": [
      "./packages/pi-condense/index.ts",
      "./packages/pi-insights/index.ts",
      "./packages/pi-permission-system/src/index.ts",
      "./packages/pi-plan-mode/src/index.ts",
      "./packages/pi-subagents/index.ts",
      "./packages/pi-tool-repair/tool-repair.ts",
      "./packages/pi-commentary/index.ts",
      "./packages/pi-voice-clone/index.ts",
      "./packages/pi-sandbox-config/index.ts",
      "./packages/pi-hermes-memory/src/index.ts",
      "./packages/pi-nano-banana/index.ts",
      "./packages/pi-brag/index.ts",
      "./packages/pi-observations/index.ts",
      "./packages/pi-browser/index.ts",
      "./packages/pi-anvil-pulse/index.ts",
      "./packages/pi-handoff/index.ts",
      "./packages/pi-session-retro/index.ts",
      "./packages/pi-asd-ste/index.ts"
    ],
    "skills": [
      "./packages/pi-subagents/skills",
      "./packages/pi-nano-banana/skills",
      "./packages/pi-brag/skills",
      "./node_modules/repo-graph-agent/skills",
      "./packages/pi-ship-loop/skills",
      "./packages/pi-asd-ste/skills"
    ],
    "prompts": [
      "./packages/pi-subagents/prompts",
      "./packages/pi-handoff/prompts",
      "./packages/pi-session-retro/prompts"
    ]
  },
  "description": "Anvil Extensions: an opinionated, pinned bundle of pi coding-agent extensions (context management, memory, subagent orchestration, image generation, and more).",
  "license": "MIT",
  "dependencies": {
    "@upstash/context7-pi": "0.1.2",
    "pi-mcp-adapter": "2.33.0",
    "repo-graph-agent": "git+https://github.com/fakoli/repo-graph.git#v0.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent"
  }
}
