{
  "name": "pi-repo-graph",
  "version": "0.2.0",
  "private": true,
  "description": "Local repository diagrams, incremental keyword and semantic search, and optional reranking for Pi.",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "repo_graph/**/*.py",
    "repo_graph/assets/*.html",
    "repo_graph/assets/*.js",
    "scripts/*.py",
    "skills",
    "tests/*.py",
    "tests/*.mjs",
    "tests/*.cjs",
    "pyproject.toml",
    "uv.lock",
    "README.md",
    "UPSTREAM.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/run-tests.mjs",
    "test:ux": "node tests/ux.mjs"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
